# ===== Blockchain =====
NETWORK=localhost                 # localhost | sepolia
RPC_URL=http://127.0.0.1:8545     # Sepolia: https://sepolia.infura.io/v3/<KEY> hoặc Alchemy
PRIVATE_KEY=0x...                 # ví deploy/oracle — KHÔNG commit ví thật
ETHERSCAN_API_KEY=
ENERGY_TOKEN_ADDRESS=
ENERGY_MARKET_ADDRESS=

# ===== MQTT =====
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=p2p

# ===== AI service (ai_model/src/service_lstm.py) =====
AI_API_URL=http://127.0.0.1:8000  # HTTP của AI (cổng này cũng là cổng AI mở)
AI_HOUSES=                        # ghi đè công suất hộ gắn phần cứng thật: H01:20:5 (mã:W phát:W dùng); trống = theo model_config
SITE_UTC_OFFSET=7                 # múi giờ công trình (feature giờ trong ngày của LSTM)

# ===== Smart contract / bridge (contracts/) =====
SEPOLIA_RPC_URL=                  # https://eth-sepolia.g.alchemy.com/v2/<KEY> — trống thì dùng RPC public
SLOT_DURATION=                    # giây/slot; trống = 120 (local) hoặc 300 (Sepolia)
PENALTY_BPS=2000                  # phạt 20% giá trị phần điện giao thiếu
REWARD_PER_KWH=1                  # thưởng 1 SOLAR / kWh giao thành công
SEED_TOKENS=1000                  # số SOLAR cấp cho mỗi hộ khi seed
SEED_HOUSES=                      # chỉ Sepolia: H01:0xVíA,H02:0xVíB,...
AUTO_TRADE=false                  # true = bridge tự đặt lệnh cho các hộ theo dự báo AI
ASK_PRICE_KWH=2.0                 # giá bán tự động (SOLAR/kWh)
BID_PRICE_KWH=2.6                 # giá mua tự động (SOLAR/kWh)
HOUSE_KEYS=                       # chỉ Sepolia + AUTO_TRADE: H01:0xPrivKey,... (local tự dùng ví hardhat)

# Hộ giả lập cho npm run mock: mã:công suất phát W:công suất dùng W
MOCK_HOUSES=H01:4000:1500,H02:3500:1800,H03:400:3200,H04:300:2600,H05:3000:1200
MOCK_FORECAST=true                # false = mock chỉ gửi telemetry, dùng khi chạy AI thật
