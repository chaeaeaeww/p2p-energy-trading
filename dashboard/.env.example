# Copy file này thành .env (hoặc .env.local) rồi điền giá trị thật.
# Mọi biến của Vite phải bắt đầu bằng VITE_ và chỉ được đọc khi chạy `npm run dev` / `npm run build`.
# KHÔNG đặt private key ở đây — frontend ký giao dịch bằng MetaMask.

# ===== IoT / MQTT =====
# Trình duyệt chỉ kết nối MQTT qua WebSocket (không dùng được TCP 1883).
#   Mosquitto local:  ws://localhost:9001   (Mosquitto cần bật listener websockets)
#   HiveMQ public:    wss://broker.hivemq.com:8884/mqtt
VITE_MQTT_WS_URL=ws://localhost:9001
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=
# Topic: <prefix>/<houseId>/telemetry  và  <prefix>/<houseId>/forecast
VITE_MQTT_TOPIC_PREFIX=p2p
# Sau bao nhiêu giây không có dữ liệu thì coi là mất tín hiệu
VITE_STALE_AFTER_SEC=15

# ===== Blockchain =====
# Hardhat local:  31337 / http://127.0.0.1:8545 / để trống ETHERSCAN
# Sepolia:        11155111 / https://sepolia.infura.io/v3/<KEY> / https://sepolia.etherscan.io
VITE_CHAIN_ID=31337
VITE_CHAIN_NAME=Hardhat Local
VITE_RPC_URL=http://127.0.0.1:8545
VITE_ETHERSCAN_BASE_URL=

# Địa chỉ in ra sau khi chạy script deploy trong /contracts
VITE_ENERGY_MARKET_ADDRESS=
# Tuỳ chọn — nếu trống, dashboard tự đọc market.token()
VITE_ENERGY_TOKEN_ADDRESS=
# Block deploy contract (Sepolia nên điền để quét log nhanh)
VITE_DEPLOY_BLOCK=0
VITE_POLL_MS=4000
